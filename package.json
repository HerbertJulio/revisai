{
  "name": "revisai",
  "version": "0.1.0",
  "private": true,
  "description": "Revisaí: a oficina avisa o cliente antes da troca de óleo e das revisões vencerem, e compra as peças certas na hora certa.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:publicacao": "vitest run && next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/gerar-seed.ts",
    "banco:local": "scripts/supabase-local/sb.sh",
    "test:banco": "BANCO_TESTE_URL=postgres://postgres@127.0.0.1:54322/postgres vitest run tests/banco"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HerbertJulio/revisai.git"
  },
  "author": "Herbert Vicente Cotta Julio",
  "dependencies": {
    "@ai-sdk/google": "4.0.85",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "ai": "7.0.122",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.56.0",
    "lz-string": "1.5.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "uqr": "0.1.3",
    "web-push": "3.6.7",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "mailparser": "3.9.40",
    "pg": "8.16.3",
    "smtp-server": "3.19.23",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
