# Copie para .env.local. Sem estas variáveis o app funciona com o catálogo de exemplo
# e os pedidos e cadastros de interesse ficam desligados.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: protege a rota diária que mantém o banco grátis do Supabase ativo (Vercel Cron).
CRON_SECRET=

# Painel da equipe (/equipe). A chave tem 64 caracteres hexadecimais (openssl rand -hex 32) e o banco
# guarda só o hash SHA-256 dela na tabela privado.chaves, com o nome 'equipe'.
EQUIPE_SENHA=
EQUIPE_CHAVE=
