# Copie para .env.local (no computador) ou cadastre na Vercel (Settings > Environment Variables).
# Cada bloco diz o que liga. Sem um bloco, aquela parte fica desligada e o resto funciona.
# Segredos só aqui ou na Vercel: nunca no código nem no repositório.
#
# No computador, com o banco local (npm run banco:local -- start), use:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_PUBLISHABLE_KEY=sb_publishable_local
#   SISTEMA_CHAVE=chave-local-do-sistema-para-desenvolvimento-0001
#   CRON_SECRET=segredo-local-do-cron

# ---------------------------------------------------------------- banco, contas e login
# Sem estas duas, o app da oficina funciona só no aparelho e a loja mostra o catálogo de exemplo.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# A chave do sistema: o servidor usa nas rotinas, nos webhooks e para montar o catálogo das lojas.
# 64 caracteres hexadecimais (openssl rand -hex 32). O banco guarda só o hash SHA-256 dela em
# privado.chaves, com o nome 'sistema'. Ao trocar, grave o hash novo:
#   update privado.chaves set hash = encode(sha256('<chave nova>'::bytea), 'hex') where nome = 'sistema';
# EQUIPE_CHAVE é o nome antigo e ainda vale enquanto SISTEMA_CHAVE não existir.
SISTEMA_CHAVE=
# EQUIPE_CHAVE=

# O endereço do site (links nos e-mails, gatilhos da nota fiscal, notificações).
SITE_URL=https://revisai.howlks.com

# Protege a rotina diária (/api/cron/manter-ativo, chamada pelo Vercel Cron): avisos, cobranças,
# limpeza e o que mais roda uma vez por dia. Sem ela, a rotina não roda.
CRON_SECRET=

# A área da equipe (/admin). Opcional: com EQUIPE_HOST, só abre neste endereço (e o endereço só abre
# a área da equipe); com EQUIPE_IPS junto, só destes IPs (IPv4 exatos ou com máscara, como
# 200.1.2.0/24, separados por vírgula). Fora disso, a página parece não existir.
# EQUIPE_HOST=equipe.revisai.howlks.com
# EQUIPE_IPS=

# A verificação de pessoa (Cloudflare Turnstile, grátis) antes de mandar o código de login e nos
# formulários do site e do agendamento. Só liga com as duas chaves. Para o login, ligue também em
# Supabase > Authentication > Attack Protection (Turnstile, com a chave secreta) depois de publicar
# o site com a TURNSTILE_SITE_KEY; ao trocar estas chaves, publique de novo.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- inteligência artificial
# Ordem de serviço por voz, agente no WhatsApp e a voz das perguntas. Na Vercel, sem chave, a IA usa
# o AI Gateway (OIDC). Fora dela, use uma chave do Google AI Studio ou do AI Gateway.
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_GATEWAY_API_KEY=
# AGENTE_MODELO=google/gemini-3.6-flash
# AGENTE_MODELO_GOOGLE=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash
# VOZ_MODELO=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview

# ---------------------------------------------------------------- WhatsApp (Cloud API da Meta)
# O agente que recebe áudios e fotos dos mecânicos e os avisos por modelo aprovado.
# Webhook: https://<site>/api/whatsapp, com o WHATSAPP_VERIFY_TOKEN.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_NUMERO=5521999990000
# WHATSAPP_API_VERSAO=v23.0

# Modelos de mensagem aprovados na Meta para os avisos. WHATSAPP_MODELO_AVISO vale para todos os
# tipos; um tipo pode ter o seu (WHATSAPP_MODELO_PEDIDO_NOVO, _ALERTA_NOVO, _PAGAMENTO_INFORMADO,
# _PEDIDO_SITUACAO, _ALERTA_RESPOSTA, _LINK_RESPOSTA, _AGENDAMENTO_ONLINE, _SUPORTE_RESPOSTA).
# WHATSAPP_MODELO_AVISO=
# WHATSAPP_MODELO_IDIOMA=pt_BR
# Os avisos da área da loja, com os parâmetros de cada um em lib/loja/avisos.ts:
# WHATSAPP_MODELO_LOJA_PEDIDO=
# WHATSAPP_MODELO_LOJA_ALERTA=
# WHATSAPP_MODELO_LOJA_PIX=
# WHATSAPP_MODELO_LOJA_DEVOLUCAO=

# O WhatsApp da equipe no botão de ajuda (com DDI e DDD). Muda só depois de publicar de novo.
# NEXT_PUBLIC_SUPORTE_WHATSAPP=5521999990000

# ---------------------------------------------------------------- e-mails dos avisos (Resend)
# Os avisos por e-mail (pedido novo, resposta do cliente, cópia da aprovação). Os códigos de login
# saem pelo SMTP configurado no Supabase (Authentication > SMTP), que pode ser o mesmo Resend.
# RESEND_API_KEY=
# AVISOS_REMETENTE=Revisaí <avisos@howlks.com>
# O contato que vai nas notificações do celular (mailto: ou https://). Padrão: o SITE_URL.
# VAPID_ASSUNTO=mailto:contato@revisai.howlks.com

# ---------------------------------------------------------------- dados da empresa
# Aparecem nos termos, na política de privacidade, no rodapé e nos e-mails. Vazios: [a preencher].
# EMPRESA_RAZAO_SOCIAL=
# EMPRESA_CNPJ=
# EMPRESA_ENDERECO=
# EMPRESA_EMAIL_PRIVACIDADE=
# EMPRESA_EMAIL_CONTATO=
# EMPRESA_ENCARREGADO=
# EMPRESA_FORO=da comarca de Rio de Janeiro/RJ

# ---------------------------------------------------------------- cobrança do Pro e das lojas
# Sem gateway, a assinatura é combinada pelo WhatsApp da equipe. Detalhes em lib/cobranca/index.ts.
# Asaas (Pix todo mês, cartão, boleto e a nota fiscal de cada mensalidade).
# Webhook: https://<site>/api/pagamentos/asaas, com o token abaixo.
# ASAAS_API_KEY=
# ASAAS_AMBIENTE=sandbox
# ASAAS_WEBHOOK_TOKEN=
# NFSE_CODIGO_SERVICO=
# NFSE_ID_SERVICO=
# NFSE_NOME_SERVICO=
# NFSE_ISS=2
# Efí (Pix Automático). Webhook: https://<site>/api/pagamentos/efi?s=<EFI_WEBHOOK_SEGREDO>&ignorar=
# EFI_CLIENT_ID=
# EFI_CLIENT_SECRET=
# EFI_CERTIFICADO_BASE64=
# EFI_CERTIFICADO_SENHA=
# EFI_AMBIENTE=homologacao
# EFI_CHAVE_PIX=
# EFI_WEBHOOK_SEGREDO=

# A chave Pix do Revisaí para a oficina pagar os pacotes de alertas com QR Code.
# Tipo: cnpj, cpf, email, telefone ou aleatoria. Sem estas, a equipe combina pelo WhatsApp.
# REVISAI_PIX_TIPO=
# REVISAI_PIX_CHAVE=
# REVISAI_PIX_NOME=
# REVISAI_PIX_CIDADE=

# ---------------------------------------------------------------- notas fiscais das oficinas
# Focus NFe. O certificado A1 e a senha de cada oficina vão direto para a Focus: o Revisaí não guarda.
# FISCAL_CHAVE cifra os tokens das empresas no banco (openssl rand -hex 32).
# Detalhes em lib/fiscal/index.ts.
# FOCUS_NFE_TOKEN=
# FISCAL_CHAVE=
# FISCAL_WEBHOOK_SEGREDO=

# ---------------------------------------------------------------- carro pela placa
# consultadeplaca.net (cobra por consulta). Sem token, a oficina preenche o carro à mão.
# PLACA_API_TOKEN=
# PLACA_API_PROVEDOR=consultadeplaca

# ---------------------------------------------------------------- só no computador (nunca em produção)
# Gateways e serviços de mentira para testar as telas sem gastar nada.
# COBRANCA_PROVEDOR=teste
# COBRANCA_TESTE_SEGREDO=segredo-de-teste
# FISCAL_PROVEDOR=teste
# FISCAL_TESTE_SEGREDO=segredo-de-teste
# PLACA_API_PROVEDOR=teste
# AVISOS_RESEND_URL=
# AVISOS_WHATSAPP_URL=
# AGENTE_GOOGLE_URL=
