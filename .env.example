# Copie para .env.local. Sem estas variáveis o app funciona com o catálogo de exemplo
# e os pedidos, os cadastros de interesse, os painéis e a IA ficam desligados.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: protege a rota diária que mantém o banco grátis do Supabase ativo (Vercel Cron).
CRON_SECRET=

# Painel administrativo (/admin) e sessão dos fornecedores. A chave tem 64 caracteres hexadecimais
# (openssl rand -hex 32) e o banco guarda só o hash SHA-256 dela na tabela privado.chaves, com o nome 'equipe'.
EQUIPE_SENHA=
EQUIPE_CHAVE=

# Ordem de serviço por voz. Na Vercel, a IA usa o AI Gateway sozinha (crédito grátis todo mês).
# Fora dela, use uma chave grátis do Google AI Studio ou uma chave do AI Gateway.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GATEWAY_API_KEY=
# AGENTE_MODELO=google/gemini-3.6-flash
# AGENTE_MODELO_GOOGLE=gemini-2.5-flash

# Agente no WhatsApp (WhatsApp Cloud API da Meta). Sem estas, a ordem por voz no app continua funcionando.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_NUMERO=
# WHATSAPP_API_VERSAO=v23.0
# SITE_URL=https://revisai.howlks.com
